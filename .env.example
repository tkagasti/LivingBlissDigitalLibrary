# Copy this file to .env.local for development. In Hostinger, add these values
# as application environment variables; do not upload the real password.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_hostinger_database_user
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=your_hostinger_database_name
DB_CONNECTION_LIMIT=5

# Leave false for a database on the same Hostinger server. Set true only when
# your remote MySQL endpoint provides a trusted TLS certificate.
DB_SSL=false

# Public origin used to validate redirects and OAuth callbacks.
AUTH_BASE_URL=https://library.livingbliss.org

# Generate three independent random secrets of at least 32 characters each.
AUTH_OTP_SECRET=replace_with_a_high_entropy_secret
AUTH_ENCRYPTION_SECRET=replace_with_a_different_high_entropy_secret

# Google Cloud OAuth web application.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Microsoft Entra web application configured for personal and organisational accounts.
MICROSOFT_CLIENT_ID=replace_with_microsoft_client_id
MICROSOFT_CLIENT_SECRET=replace_with_microsoft_client_secret

# Hostinger transactional mailbox used for OTP and account security email.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@livingbliss.org
SMTP_PASSWORD=replace_with_mailbox_password
SMTP_FROM=Living Bliss <no-reply@livingbliss.org>
